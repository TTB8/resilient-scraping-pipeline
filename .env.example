# Copy to .env to override defaults. Every variable is optional; the defaults are the polite ones.
# Full descriptions: src/scraping_pipeline/config.py. No secrets belong here: the pipeline needs none.

# PIPELINE_DATA_DIR=data

# --- Politeness (hard ceilings: 5 req/s, 8 concurrent per domain; robots.txt is always obeyed)
# PIPELINE_USER_AGENT="resilient-scraping-pipeline/0.1 (+https://github.com/TTB8/resilient-scraping-pipeline)"
# PIPELINE_REQUESTS_PER_SECOND=1.0
# PIPELINE_BURST=1
# PIPELINE_MAX_CONCURRENCY_PER_DOMAIN=2
# PIPELINE_REQUEST_TIMEOUT_S=20

# --- Retries and circuit breaker
# PIPELINE_MAX_ATTEMPTS=5
# PIPELINE_BACKOFF_BASE_S=1.0
# PIPELINE_BACKOFF_CAP_S=60
# PIPELINE_MAX_RETRY_AFTER_S=300
# PIPELINE_MAX_CRAWL_DELAY_S=60
# PIPELINE_BREAKER_FAILURE_THRESHOLD=5
# PIPELINE_BREAKER_COOLDOWN_S=30
# PIPELINE_BREAKER_MAX_OPEN_CYCLES=3

# --- Crawl scope (unset = whole site)
# PIPELINE_MAX_PAGES=
# PIPELINE_MAX_DEPTH=

# --- Validation: share of rows allowed to fail the contract before the run fails
# PIPELINE_MAX_FAILURE_RATE=0.0

# --- Targets (tests point these at the local fixture server)
# PIPELINE_BOOKS_BASE_URL=https://books.toscrape.com/
# PIPELINE_QUOTES_BASE_URL=https://quotes.toscrape.com/

# --- Logging
# PIPELINE_LOG_LEVEL=INFO
# PIPELINE_LOG_FORMAT=json
